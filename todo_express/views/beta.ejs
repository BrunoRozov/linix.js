<!DOCTYPE html>
<html lang="en">
<head>
    <title>todo list</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col s12">
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Update Task</span>

                        <% if (error) { %>
                            <div class="row teal lighten-4">
                                <div class="col s12">
                                    <p class="center-align red-text text-darken-2"><%= error %></p>
                                </div>
                            </div>
                        <% } %>

                        <div class="row">
                            <% if (task) { %>
                                <form class="col s12" method="post" action="/update-task">
                                    <div class="row">
                                        <div class="input-field col s12">
                                            <input placeholder="Task" id="task" type="text" name="task" value="<%= task.task %>">
                                            <label for="task" class="active">Update Task</label>
                                            <input id="taskId" type="hidden" name="taskId" value="<%= task.id %>">
                                        </div>
                                    </div>

                                    <input class="btn" type="submit" value="Update Task">
                                    <a class="btn" href="/">Cancel</a>
                                </form>
                            <% } else { %>
                                <div class="col s12">
                                    <p>Task not found.</p>
                                    <a class="btn" href="/">Back to list</a>
                                </div>
                            <% } %>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
